<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. VIDEO PLAYER WRAPPER (Slides to left when Menu opens) -->
    <FrameLayout
        android:id="@+id/playerWrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            app:use_controller="false"
            app:surface_type="surface_view"
            app:resize_mode="fit" />
    </FrameLayout>

    <!-- 2. TOP HAIRLINE ANIMATED LOADING BAR -->
    <ProgressBar
        android:id="@+id/topProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_blue"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 3. CENTER STATUS PILL (Shows "Loading next video...", "Searching...", etc.) -->
    <LinearLayout
        android:id="@+id/centerStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_now_playing_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/accent_blue" />

        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Loading next video…" />
    </LinearLayout>

    <!-- 4. BOTTOM HUD (ALWAYS VISIBLE IN NORMAL MODE) -->
    <LinearLayout
        android:id="@+id/bottomHUD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingTop="14dp"
        android:paddingEnd="36dp"
        android:paddingBottom="14dp">

        <!-- Left: Title, Channel & Like/Dislike Stats -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBottomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Satisfying Domino Trick Compilation" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBottomChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Domino King" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="   •   "
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBottomLikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👍 48K"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="   "
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvBottomDislikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👎 312"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: Time Pill (Always Visible in Normal Mode) -->
        <TextView
            android:id="@+id/tvBottomTimePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_now_playing_pill"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="00:24 / 00:58" />
    </LinearLayout>

    <!-- 5. BOTTOM HAIRLINE SEEK PROGRESS BAR OVERLAY (Appears on Left/Right Scrub) -->
    <LinearLayout
        android:id="@+id/scrubOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="65dp"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvScrubTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="+10s   00:20 / 00:58" />

        <ProgressBar
            android:id="@+id/scrubProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="1000"
            android:progressDrawable="@drawable/seek_progress_drawable" />
    </LinearLayout>

    <!-- 6. RIGHT-SIDE VERTICALLY CENTERED FROSTED MENU (Press Menu Button) -->
    <LinearLayout
        android:id="@+id/menuDrawer"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_frosted_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 1. Search -->
        <TextView
            android:id="@+id/btnMenuSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill_button"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="🔍   Search"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 2. Quality Toggle -->
        <TextView
            android:id="@+id/btnMenuQuality"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill_button"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="⚙️   Quality: Auto"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- 3. Subtitles Toggle -->
        <TextView
            android:id="@+id/btnMenuSubtitles"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill_button"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="💬   Subtitles: Off"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- 4. History -->
        <TextView
            android:id="@+id/btnMenuHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill_button"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="🕒   History"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- 5. Exit App -->
        <TextView
            android:id="@+id/btnMenuExit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_button"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="🚪   Exit App"
            android:textColor="#FF453A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7. SEARCH / HISTORY SHELF OVERLAY -->
    <LinearLayout
        android:id="@+id/shelfOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EB000000"
        android:orientation="vertical"
        android:padding="36dp"
        android:visibility="gone"
        tools:visibility="gone">

        <!-- Search Bar Header -->
        <LinearLayout
            android:id="@+id/searchHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearchInput"
                android:layout_width="400dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_button"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnSubmitSearch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Search"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shelf Title -->
        <TextView
            android:id="@+id/tvShelfTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Watch History" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShelf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- 8. FROSTED EXIT DIALOG (Double-tap Back) -->
    <LinearLayout
        android:id="@+id/exitDialog"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_exit_dialog"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exit_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Are you sure you want to exit?"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnExitCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExitConfirm"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/exit"
                android:textColor="#FF453A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
